    "%sql\n",
    "CREATE TABLE demo.delta_lake.sales_delta\n",
    "USING DELTA\n",
    "AS\n",
    "SELECT\n",
    "  id % 1000 AS branch_id,\n",
    "  id % 100000 AS customer_id,\n",
    "  CAST(100 + RAND() * 900 AS INT) AS amount,\n",
    "  DATE_ADD('2026‑01‑01', id % 90) AS sale_date\n",
    "FROM RANGE(10000000);"
   ]
  }
